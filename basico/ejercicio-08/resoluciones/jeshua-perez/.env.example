# Ejemplo de configuracion. Copiar a .env y ajustar.
#
#   cp env.example .env      (Linux/Mac)
#   copy .env.example .env   (Windows)
#
# El .env real NUNCA se sube al repositorio: lleva secretos.

# Obligatorias -------------------------------------------------------------
# Sin estas la aplicacion no arranca.
APP_NOMBRE=Escuderia Hiperdeportivos
API_CLAVE=pon-aqui-tu-clave-de-al-menos-16-caracteres

# Opcionales ---------------------------------------------------------------
# Si faltan se usa el valor por defecto que aparece al lado.
NODE_ENV=development          # development | test | production
PORT=3000                     # entero entre 1 y 65535
LOG_NIVEL=debug               # error | warn | info | debug
MAX_VELOCIDAD_KMH=400         # entero positivo
TELEMETRIA_ACTIVA=true        # true | false
FACTOR_CONVERSION_MILLAS=0.621371
